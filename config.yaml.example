# progress_tracker/config.yaml.example
#
# progress_tracker was split out of embodied_perceptron/supervision/ into its own repo
# (github.com/tsyhuuuu/progress_tracker), so it no longer lives inside the repo it watches -
# scan_status.py needs to be told, on EACH machine, where that machine's own embodied_perceptron
# checkout is.
#
# Copy this file to config.yaml (gitignored - every machine's path is different, so it must
# never be committed) and edit repo_root to match this machine's actual checkout.
#
# repo_root can be absolute, or relative to this config.yaml's own directory (progress_tracker/).
# The default below assumes the common layout: progress_tracker/ and embodied_perceptron/ as
# sibling directories under the same parent - adjust if a machine's layout differs.

repo_root: ../embodied_perceptron
